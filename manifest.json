{
  "manifest_version": 3,
  "name": "Twitch Ads Blocker (VAFT Wrapper)",
  "version": "0.5.0",
  "description": "Runs the VAFT Twitch ad-block engine automatically on twitch.tv with no uBlock/userscript setup.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-ads-blocker@gabrielcatarini",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "inject.js",
        "watchdog.js"
      ],
      "run_at": "document_start"
    }
  ]
}
